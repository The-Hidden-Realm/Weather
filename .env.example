# Copy this file to .env and fill in real values before running docker compose.

# Signs session cookies. Generate one with: openssl rand -base64 32
SESSION_SECRET=change-this-to-a-long-random-string

# Optional: identifies this app to api.weather.gov per NWS API etiquette.
CONTACT_EMAIL=you@example.com

# Set to "true" only once a reverse proxy is terminating real HTTPS in front
# of this app. Leaving it unset/false works over plain http://ip:port, but
# marking the session cookie Secure without TLS would lock everyone out —
# browsers silently drop Secure cookies over HTTP.
SESSION_COOKIE_SECURE=false
